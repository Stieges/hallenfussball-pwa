{
  "name": "hallenfussball-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/check-pdf-font-precache.cjs",
    "preview": "vite preview",
    "test:sw-precache": "rm -rf dist-swcheck && VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build --outDir dist-swcheck && node scripts/check-sw-precache.mjs dist-swcheck",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:scenarios": "node scripts/scenario-tests.mjs",
    "test:e2e": "playwright test --project=mobile-sm --project=mobile-md --project=mobile-lg --project=tablet-portrait --project=tablet-landscape --project=desktop --project=mobile-slow-3g --project=iPhone-16 --project=Pixel-9",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile-sm --project=mobile-md --project=mobile-lg",
    "test:e2e:tablet": "playwright test --project=tablet-portrait --project=tablet-landscape",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:all-viewports": "playwright test --project=mobile-sm --project=mobile-md --project=tablet-portrait --project=desktop",
    "test:e2e:cloud": "bash scripts/require-local-stack.sh && playwright test --project=cloud-setup --project=cloud-desktop --project=cloud-mobile",
    "test:e2e:cloud:fresh": "npm run test:env:reset && npm run test:e2e:cloud",
    "test:a11y": "playwright test tests/e2e/usability/accessibility.spec.ts",
    "test:visual": "bash scripts/visual-in-container.sh compare",
    "test:visual:update": "bash scripts/visual-in-container.sh update",
    "visual:metrics": "node scripts/visual-metrics/messen.mjs",
    "test:visual-metrics": "vitest run --config scripts/visual-metrics/vitest.config.mjs",
    "prepare": "husky",
    "analyze": "npm run build && open dist/stats.html",
    "tokens:check": "node scripts/check-design-token-sync.cjs",
    "terms:check": "node scripts/check-terminology.cjs",
    "findings:extract": "PYTHONPATH=scripts python3 -m findings.extract_findings reviews/ --findings-dir docs/findings",
    "findings:status": "PYTHONPATH=scripts python3 -m findings.findings_status docs/findings/",
    "findings:fix": "PYTHONPATH=scripts python3 -m findings.finding_fix",
    "findings:routing-stats": "PYTHONPATH=scripts python3 -m findings.findings_routing_stats",
    "findings:validate-freshness": "PYTHONPATH=scripts python3 -m findings.validate_review_freshness",
    "test:env:up": "bash -c 'source scripts/lib/e2e-registration-code.sh && tsx scripts/test-env-check.ts --vorher && supabase start --ignore-health-check && tsx scripts/test-env-check.ts --gesund && bash scripts/local-db-apply.sh'",
    "test:env:down": "supabase stop",
    "test:env:reset": "bash scripts/require-local-stack.sh && bash -c 'source scripts/lib/e2e-registration-code.sh && supabase db reset --local && bash scripts/local-db-apply.sh && tsx scripts/e2e-seed.ts'",
    "test:env:seed": "bash scripts/require-local-stack.sh && bash -c 'source scripts/lib/e2e-registration-code.sh && tsx scripts/e2e-seed.ts'",
    "test:env:status": "tsx scripts/test-env-check.ts --gesund && bash scripts/test-env-status.sh",
    "test:env:aufraeumen": "tsx scripts/test-env-check.ts --aufraeumen"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/react": "^10.75.1",
    "@supabase/supabase-js": "^2.117.3",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "^2.0.2",
    "i18next": "^26.4.4",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "wicg-inert": "^3.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "node-localstorage": "^3.0.5",
    "pdfjs-dist": "6.4.299",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  }
}
