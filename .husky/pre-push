# Vor-Push-Prüfung wie die CI (@TA-019, @TA-020): führt den Commit mit dem neuesten origin/main zusammen
# (ohne den Arbeitsbaum anzufassen) und prüft das Ergebnis in einer temporären Arbeitskopie: Lint, Build,
# Szenario-Prüfung, Härtetest der visuellen Messung und Playwright-Specs der geänderten Bereiche ohne Datenbank.
# Löschen eines Branches und Tags laufen ohne Prüfung durch. Details: scripts/vor-push/vor-push.mjs

# Hinweis (kein Abbruch): geprüft wird der COMMITTETE Stand, nicht lokale, nicht committete Änderungen.
UNCOMMITTED_CI_FILES=$(git diff --name-only | grep -E "playwright\.config\.ts|vite\.config\.ts|\.github/workflows/" || true)
if [ -n "$UNCOMMITTED_CI_FILES" ]; then
  echo ""
  echo "⚠️  Nicht committete CI-relevante Änderungen (werden NICHT hochgeladen und NICHT geprüft):"
  echo "$UNCOMMITTED_CI_FILES" | while read -r file; do echo "   - $file"; done
  echo ""
fi

node scripts/vor-push/vor-push.mjs "$@"
